<UserControl x:Class="SsmsGitBlame.GitSearchToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SsmsGitBlame"
             xmlns:platformUi="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900"
             Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>
        <!-- Toggle button style for Cc, W, .* adapting to Light & Dark Theme -->
        <Style x:Key="JbThemedToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}"/>
                                <Setter Property="Opacity" Value="1.0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#263574F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3574F0"/>
                                <Setter Property="Foreground" Value="#3574F0"/>
                                <Setter Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Result ListBox Item Style -->
        <Style x:Key="JbThemedResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A3574F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333574F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="1.2*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Header (Title, Matches count, File mask) -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Find in Files" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                <TextBlock x:Name="MatchStatsTextBlock" Margin="12,0,0,0" Opacity="0.7" Text="0 matches" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="FileMaskCheckBox" Content="File mask:" IsChecked="True"
                          Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"
                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Border Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                        BorderThickness="1" CornerRadius="4">
                    <TextBox x:Name="FilePatternBox" Text="*.sql" Width="80" Height="22" 
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"
                             CaretBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"
                             VerticalContentAlignment="Center" Padding="4,0" KeyDown="OnSearchTriggerKeyDown"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 1. JetBrains Search Input Box -->
        <Border Grid.Row="1" x:Name="SearchBoxContainer"
                Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                BorderBrush="#3574F0" BorderThickness="1.5" CornerRadius="5" Height="32" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Opacity="0.6" Margin="8,0,6,0" VerticalAlignment="Center"/>

                <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                         Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"
                         CaretBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"
                         FontSize="13" VerticalContentAlignment="Center"
                         TextChanged="OnSearchBoxTextChanged" KeyDown="OnSearchTriggerKeyDown"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button x:Name="ClearButton" Content="✕" Width="20" Height="20" Background="Transparent" 
                            BorderThickness="0"
                            Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"
                            Opacity="0.6" Cursor="Hand" Click="OnClearButtonClick"
                            Visibility="Collapsed" Margin="0,0,4,0"/>

                    <ToggleButton x:Name="MatchCaseToggle" Style="{StaticResource JbThemedToggleButtonStyle}" 
                                  ToolTip="Match Case (Alt+C)" Click="OnToggleOptionClick">
                        <TextBlock Text="Cc" FontWeight="Bold" FontSize="11"/>
                    </ToggleButton>

                    <ToggleButton x:Name="WholeWordToggle" Style="{StaticResource JbThemedToggleButtonStyle}" 
                                  ToolTip="Words (Alt+W)" Click="OnToggleOptionClick">
                        <TextBlock Text="W" FontWeight="Bold" FontSize="11"/>
                    </ToggleButton>

                    <ToggleButton x:Name="RegexToggle" Style="{StaticResource JbThemedToggleButtonStyle}" 
                                  ToolTip="Regex (Alt+X)" Click="OnToggleOptionClick">
                        <TextBlock Text=".*" FontWeight="Bold" FontSize="11"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Repository Context / Scope Indicator -->
        <DockPanel Grid.Row="2" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Repo..." Padding="6,2"
                    Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                    Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}"
                    Cursor="Hand" Click="OnSelectRepoButtonClick"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#263574F0" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                    <TextBlock Text="Git Repository" FontSize="11" Foreground="#3574F0" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="RepoPathTextBlock" Text="Configuring repo..." Opacity="0.75"
                           FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- 3. Search Results List -->
        <Border Grid.Row="3"
                Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="ResultsListBox" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource JbThemedResultItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionChanged="OnResultSelectionChanged"
                     MouseDoubleClick="OnResultMouseDoubleClick"
                     KeyDown="OnResultsListKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <local:SearchHighlightBlock Grid.Column="0" Item="{Binding}"
                                                        FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"/>

                            <TextBlock Grid.Column="1" Opacity="0.65" FontSize="11" VerticalAlignment="Center" Margin="16,0,4,0"
                                       Foreground="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowTextBrushKey}}">
                                <Run Text="{Binding RelativePath, Mode=OneWay}"/>
                                <Run Text=":"/><Run Text="{Binding LineNumber, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 4. Draggable Splitter -->
        <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                      Cursor="SizeNS"/>

        <!-- 5. Code Preview Section -->
        <Grid Grid.Row="5" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource {x:Static platformUi:EnvironmentColors.CommandBarGradientBeginBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                    BorderThickness="1,1,1,0" Padding="8,4" CornerRadius="4,4,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PreviewFileNameText" FontWeight="SemiBold" Text="No file selected"/>
                    <TextBlock x:Name="PreviewFileDirText" Opacity="0.7" Margin="8,0,0,0" Text=""/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" x:Name="CodePreviewHost"
                    BorderBrush="{DynamicResource {x:Static platformUi:EnvironmentColors.ToolWindowBorderBrushKey}}"
                    BorderThickness="1"/>
        </Grid>

        <!-- 6. Footer Status / Action Bar -->
        <Grid Grid.Row="6" Margin="0,8,0,0">
            <TextBlock x:Name="StatusTextBlock" Opacity="0.75" VerticalAlignment="Center" Text="Ready"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Enter to Open in Editor" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Open in Editor" Padding="12,3" Background="#3574F0" Foreground="White" 
                        BorderThickness="0" Cursor="Hand" Click="OnOpenSelectedInEditorClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>